# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Local variable files
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!*.tfvars.json.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
