# Platform Launchpad Argo CD bootstrap image versions.
#
# These versions are intentionally pinned so that rebuilding the platform
# produces the same Argo CD runtime rather than silently consuming newer
# upstream releases.

ARGOCD_VERSION="v3.5.2"
DEX_VERSION="v2.45.1"
REDIS_VERSION="8.2.3-alpine"

ARGOCD_UPSTREAM_IMAGE="quay.io/argoproj/argocd"
DEX_UPSTREAM_IMAGE="ghcr.io/dexidp/dex"
REDIS_UPSTREAM_IMAGE="public.ecr.aws/docker/library/redis"
