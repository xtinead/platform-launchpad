APP_NAME=Platform Launchpad API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true

DATABASE_URL=postgresql+psycopg2://platform_user:platform_pass@localhost:5432/platform_launchpad

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:3000","https://launchpad.example.com"]
